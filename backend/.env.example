# Local development (docker-compose postgres). In Vercel, use the Neon *pooled*
# connection string instead (host with the -pooler suffix) — see docs/architecture.md.
DATABASE_URL=postgresql+asyncpg://pmp:pmp@localhost:5432/pmp_dev

# JWT
JWT_SECRET_KEY=change-me-to-a-random-64-char-secret-in-every-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Vercel Cron authentication (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=change-me-cron-secret

# CORS
FRONTEND_ORIGIN=http://localhost:5173

ENVIRONMENT=development
